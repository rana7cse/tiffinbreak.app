/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * The R2 binding (bucket tiffinbreak-covers) is added by the cover-photo ticket.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tiffinbreak",
	"compatibility_date": "2026-11-19",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Auth config, read from the Worker env. Locally they come from .dev.vars
	// (copy .dev.vars.example); in production use `wrangler secret put`.
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"BETTER_AUTH_URL",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"FACEBOOK_CLIENT_ID",
			"FACEBOOK_CLIENT_SECRET"
		]
	},
	// Production origin: Custom Domain attached on deploy (zone is in this account).
	"routes": [{ "pattern": "tiffinbreak.faridpuri.com", "custom_domain": true }],
	// workers.dev and preview URLs stay on so pull requests get previews.
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tiffinbreak",
			"database_id": "963f4743-c7d8-4973-a327-ce48b64ebc70",
			// SQL written by drizzle-kit (`npm run db:generate`).
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "16b2e8cb837145d0b646bd79325f6d07"
		}
	]
}
