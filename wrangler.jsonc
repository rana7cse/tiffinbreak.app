/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 * Bindings (R2, KV) are added by later tickets.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tiffinbreak",
	"compatibility_date": "2026-11-19",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Auth config, read from the Worker env. Locally they come from .dev.vars
	// (copy .dev.vars.example); in production use `wrangler secret put`.
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"BETTER_AUTH_URL",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"FACEBOOK_CLIENT_ID",
			"FACEBOOK_CLIENT_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tiffinbreak",
			// Placeholder id: enough for local dev and tests. #13 creates the
			// production database and replaces this with its real id.
			"database_id": "00000000-0000-0000-0000-000000000000",
			// SQL written by drizzle-kit (`npm run db:generate`).
			"migrations_dir": "migrations"
		}
	]
}
