/**
 * Wrangler config: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tiffinbreak",
	"compatibility_date": "2026-11-19",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Auth config, read from the Worker env. Locally they come from .dev.vars
	// (copy .dev.vars.example); in production use `wrangler secret put`.
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"BETTER_AUTH_URL",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"FACEBOOK_CLIENT_ID",
			"FACEBOOK_CLIENT_SECRET"
		]
	},
	// Production origin: Custom Domain attached on deploy (zone is in this account).
	"routes": [{ "pattern": "tiffinbreak.faridpuri.com", "custom_domain": true }],
	// workers.dev and preview URLs stay on so pull requests get previews.
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tiffinbreak",
			"database_id": "963f4743-c7d8-4973-a327-ce48b64ebc70",
			// SQL written by drizzle-kit (`npm run db:generate`).
			"migrations_dir": "migrations"
		}
	],
	// Cover photos. The remote bucket `tiffinbreak-covers` is created by a human.
	"r2_buckets": [
		{
			"binding": "COVERS",
			"bucket_name": "tiffinbreak-covers"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "16b2e8cb837145d0b646bd79325f6d07"
		}
	],
	// Per-Writer rate limits on write paths (app/lib/rate-limit.ts), keyed by
	// Writer id. `period` may only be 10 or 60 seconds; namespace_id is a
	// unique integer string per limit in the account.
	"ratelimits": [
		{ "name": "RL_PUBLISH", "namespace_id": "5301", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_EDIT", "namespace_id": "5302", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_LOVE", "namespace_id": "5303", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RL_REPORT", "namespace_id": "5304", "simple": { "limit": 5, "period": 60 } },
		{ "name": "RL_UPLOAD", "namespace_id": "5305", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_SCHOOL", "namespace_id": "5306", "simple": { "limit": 10, "period": 60 } }
	]
}
