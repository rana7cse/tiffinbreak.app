# Copy to .dev.vars for local dev. Never commit real values.
# Random string, 32+ chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string-32-chars-min
# Origin the app is served from (no trailing slash)
BETTER_AUTH_URL=http://localhost:5173
# Google Cloud Console > APIs & Services > Credentials (see README)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Meta for Developers > your app > Settings > Basic (see README)
FACEBOOK_CLIENT_ID=your-meta-app-id
FACEBOOK_CLIENT_SECRET=your-meta-app-secret
